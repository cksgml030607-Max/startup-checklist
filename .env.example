# Flask 서버 설정
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=replace_with_a_secure_random_string

# Google Gemini API Key (https://aistudio.google.com/ 에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# 공공데이터포털 API Key (선택/연동용: https://www.data.go.kr/)
PUBLIC_DATA_API_KEY=your_public_data_api_key_here
